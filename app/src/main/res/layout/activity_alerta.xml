<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B71C1C"
    android:keepScreenOn="true"
    android:orientation="vertical"
    tools:context=".AlertaActivity">

    <LinearLayout
        android:id="@+id/layoutAlerta"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B71C1C"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">
        <TextView
            android:id="@+id/txtAlertaTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Queda detectada"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/txtAlertaMotivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Motivo"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/txtContagem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="30"
            android:textColor="#FFFFFF"
            android:textSize="120sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/txtAlertaInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:text="segundos para o alerta ser enviado"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
        <Button
            android:id="@+id/btnEstouBem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="36dp"
            android:text="Estou bem, cancelar"
            android:textColor="#B71C1C"
            android:textSize="20sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/btnPedirAjuda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="56dp"
            app:backgroundTint="#7F1414"
            app:cornerRadius="28dp"
            android:text="Pedir ajuda agora"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />
    </LinearLayout>
</LinearLayout>
