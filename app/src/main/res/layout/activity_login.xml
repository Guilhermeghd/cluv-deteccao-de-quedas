<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F4F7"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".telas.LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="18dp">
            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_logo"
                android:importantForAccessibility="no"
                android:padding="14dp"
                android:src="@drawable/ic_escudo"
                android:tint="#FFFFFF" />
            <TextView
                android:id="@+id/txtTituloLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="14dp"
                android:text="Bem-vindo de volta"
                android:textColor="#1A1F24"
                android:textSize="26sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:text="Entre para continuar protegido"
                android:textColor="#5A6572"
                android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:backgroundTint="#FFFFFF"
            android:orientation="vertical"
            android:padding="18dp">
            <LinearLayout
                android:id="@+id/bannerErroLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_card"
                android:backgroundTint="#FDECEA"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_alerta"
                    android:tint="#B71C1C" />
                <TextView
                    android:id="@+id/txtErroLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="E-mail ou senha incorretos"
                    android:textColor="#B71C1C"
                    android:textSize="14sp" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="5dp"
                android:text="E-mail"
                android:textColor="#5A6572"
                android:textSize="13sp" />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:id="@+id/editLoginEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_campo_form"
                    android:drawableStart="@drawable/ic_email"
                    android:drawablePadding="10dp"
                    android:drawableTint="#5A6572"
                    android:hint="nome@exemplo.com"
                    android:importantForAutofill="no"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:minHeight="52dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#1A1F24"
                    android:textColorHint="#8A94A0"
                    android:textSize="15sp" />
            </FrameLayout>
            <TextView
                android:id="@+id/txtErroEmailLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_alerta"
                android:drawablePadding="5dp"
                android:drawableTint="#B71C1C"
                android:paddingTop="4dp"
                android:text=""
                android:textColor="#B71C1C"
                android:textSize="12sp"
                android:visibility="gone" />
            <Space
                android:layout_width="match_parent"
                android:layout_height="12dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="5dp"
                android:text="Senha"
                android:textColor="#5A6572"
                android:textSize="13sp" />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:id="@+id/editLoginSenha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_campo_form"
                    android:drawableStart="@drawable/ic_cadeado"
                    android:drawablePadding="10dp"
                    android:drawableTint="#5A6572"
                    android:hint="Sua senha"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:minHeight="52dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="52dp"
                    android:textColor="#1A1F24"
                    android:textColorHint="#8A94A0"
                    android:textSize="15sp" />
            <ImageButton
                android:id="@+id/btnOlhoLogin"
                android:layout_width="48dp"
                android:layout_height="52dp"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Mostrar ou esconder a senha"
                android:padding="14dp"
                android:src="@drawable/ic_olho"
                android:tint="#5A6572" />
            </FrameLayout>
            <TextView
                android:id="@+id/txtErroSenhaLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_alerta"
                android:drawablePadding="5dp"
                android:drawableTint="#B71C1C"
                android:paddingTop="4dp"
                android:text=""
                android:textColor="#B71C1C"
                android:textSize="12sp"
                android:visibility="gone" />
            <Space
                android:layout_width="match_parent"
                android:layout_height="12dp" />
            <Button
                android:id="@+id/btnEntrar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="54dp"
                app:backgroundTint="#E6EAEF"
                app:cornerRadius="27dp"
                android:text="Entrar"
                android:textColor="#5A6572"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ainda não tem conta? "
                android:textColor="#5A6572"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/btnIrCadastro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:text="Criar conta"
                android:textColor="#0B6672"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
