<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F4F7"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".CadastroActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="18dp">
            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_logo"
                android:importantForAccessibility="no"
                android:padding="14dp"
                android:src="@drawable/ic_escudo"
                android:tint="#FFFFFF" />
            <TextView
                android:id="@+id/txtTituloCadastro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="14dp"
                android:text="Criar conta"
                android:textColor="#1A1F24"
                android:textSize="26sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:text="Proteção contra quedas, no seu bolso"
                android:textColor="#5A6572"
                android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:backgroundTint="#FFFFFF"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="5dp"
                android:text="Nome"
                android:textColor="#5A6572"
                android:textSize="13sp" />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:id="@+id/editCadNome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_campo_form"
                    android:drawableStart="@drawable/ic_perfil"
                    android:drawablePadding="10dp"
                    android:drawableTint="#5A6572"
                    android:hint="Como você se chama"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLines="1"
                    android:minHeight="52dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#1A1F24"
                    android:textColorHint="#8A94A0"
                    android:textSize="15sp"
                    android:maxLength="40" />
            </FrameLayout>
            <TextView
                android:id="@+id/txtErroNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_alerta"
                android:drawablePadding="5dp"
                android:drawableTint="#B71C1C"
                android:paddingTop="4dp"
                android:text=""
                android:textColor="#B71C1C"
                android:textSize="12sp"
                android:visibility="gone" />
            <Space
                android:layout_width="match_parent"
                android:layout_height="12dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="5dp"
                android:text="E-mail"
                android:textColor="#5A6572"
                android:textSize="13sp" />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:id="@+id/editCadEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_campo_form"
                    android:drawableStart="@drawable/ic_email"
                    android:drawablePadding="10dp"
                    android:drawableTint="#5A6572"
                    android:hint="nome@exemplo.com"
                    android:importantForAutofill="no"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:minHeight="52dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#1A1F24"
                    android:textColorHint="#8A94A0"
                    android:textSize="15sp" />
            </FrameLayout>
            <TextView
                android:id="@+id/txtErroEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_alerta"
                android:drawablePadding="5dp"
                android:drawableTint="#B71C1C"
                android:paddingTop="4dp"
                android:text=""
                android:textColor="#B71C1C"
                android:textSize="12sp"
                android:visibility="gone" />
            <Space
                android:layout_width="match_parent"
                android:layout_height="12dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="5dp"
                android:text="Senha"
                android:textColor="#5A6572"
                android:textSize="13sp" />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:id="@+id/editCadSenha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_campo_form"
                    android:drawableStart="@drawable/ic_cadeado"
                    android:drawablePadding="10dp"
                    android:drawableTint="#5A6572"
                    android:hint="Mínimo de 6 caracteres"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:minHeight="52dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="52dp"
                    android:textColor="#1A1F24"
                    android:textColorHint="#8A94A0"
                    android:textSize="15sp" />
            <ImageButton
                android:id="@+id/btnOlhoSenha"
                android:layout_width="48dp"
                android:layout_height="52dp"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Mostrar ou esconder a senha"
                android:padding="14dp"
                android:src="@drawable/ic_olho"
                android:tint="#5A6572" />
            </FrameLayout>
            <TextView
                android:id="@+id/txtErroSenha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_alerta"
                android:drawablePadding="5dp"
                android:drawableTint="#B71C1C"
                android:paddingTop="4dp"
                android:text=""
                android:textColor="#B71C1C"
                android:textSize="12sp"
                android:visibility="gone" />
            <Space
                android:layout_width="match_parent"
                android:layout_height="12dp" />
            <TextView
                android:id="@+id/txtRegraTamanho"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_circulo"
                android:drawablePadding="6dp"
                android:drawableTint="#5A6572"
                android:paddingStart="2dp"
                android:paddingBottom="2dp"
                android:text="Pelo menos 6 caracteres"
                android:textColor="#5A6572"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/txtRegraIguais"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_circulo"
                android:drawablePadding="6dp"
                android:drawableTint="#5A6572"
                android:paddingStart="2dp"
                android:paddingBottom="12dp"
                android:text="As senhas coincidem"
                android:textColor="#5A6572"
                android:textSize="13sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="5dp"
                android:text="Confirmar senha"
                android:textColor="#5A6572"
                android:textSize="13sp" />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:id="@+id/editCadConfirmar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_campo_form"
                    android:drawableStart="@drawable/ic_cadeado"
                    android:drawablePadding="10dp"
                    android:drawableTint="#5A6572"
                    android:hint="Repita a senha"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:minHeight="52dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="52dp"
                    android:textColor="#1A1F24"
                    android:textColorHint="#8A94A0"
                    android:textSize="15sp" />
            <ImageButton
                android:id="@+id/btnOlhoConfirmar"
                android:layout_width="48dp"
                android:layout_height="52dp"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Mostrar ou esconder a senha"
                android:padding="14dp"
                android:src="@drawable/ic_olho"
                android:tint="#5A6572" />
            </FrameLayout>
            <TextView
                android:id="@+id/txtErroConfirmar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_alerta"
                android:drawablePadding="5dp"
                android:drawableTint="#B71C1C"
                android:paddingTop="4dp"
                android:text=""
                android:textColor="#B71C1C"
                android:textSize="12sp"
                android:visibility="gone" />
            <Space
                android:layout_width="match_parent"
                android:layout_height="12dp" />
            <Button
                android:id="@+id/btnCadastrar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="54dp"
                app:backgroundTint="#E6EAEF"
                app:cornerRadius="27dp"
                android:text="Criar conta"
                android:textColor="#5A6572"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:id="@+id/txtPrivacidade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_cadeado"
            android:drawablePadding="6dp"
            android:drawableTint="#5A6572"
            android:gravity="center"
            android:paddingTop="14dp"
            android:text="Seus dados ficam guardados só neste aparelho"
            android:textColor="#5A6572"
            android:textSize="13sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Já tem conta? "
                android:textColor="#5A6572"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/btnVoltarLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:text="Entrar"
                android:textColor="#0B6672"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
