<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de abas de baixo. Ela e incluida em todas as telas com <include layout="@layout/barra_abas" />.
     Quem pinta a aba atual e liga os cliques e a classe BarraAbas.java -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <View
        android:id="@+id/divisorAbas"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDE2E8" />
    <LinearLayout
        android:id="@+id/barraAbas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tabInicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:drawableTop="@drawable/ic_inicio"
            android:drawablePadding="2dp"
            android:drawableTint="#5A6572"
            android:gravity="center"
            android:minHeight="48dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Início"
            android:textColor="#5A6572"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/tabTrajeto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:drawableTop="@drawable/ic_trajeto"
            android:drawablePadding="2dp"
            android:drawableTint="#5A6572"
            android:gravity="center"
            android:minHeight="48dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Rota"
            android:textColor="#5A6572"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/tabClima"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:drawableTop="@drawable/ic_clima"
            android:drawablePadding="2dp"
            android:drawableTint="#5A6572"
            android:gravity="center"
            android:minHeight="48dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Clima"
            android:textColor="#5A6572"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/tabHistorico"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:drawableTop="@drawable/ic_historico"
            android:drawablePadding="2dp"
            android:drawableTint="#5A6572"
            android:gravity="center"
            android:minHeight="48dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Histórico"
            android:textColor="#5A6572"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/tabPerfil"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:drawableTop="@drawable/ic_perfil"
            android:drawablePadding="2dp"
            android:drawableTint="#5A6572"
            android:gravity="center"
            android:minHeight="48dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Perfil"
            android:textColor="#5A6572"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
